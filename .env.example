# Copy to .env.local and fill in.
# Claude API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Maps key (Maps JavaScript, Places (New), Routes, Geocoding APIs): https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Optional: Map ID for Advanced Markers (defaults to DEMO_MAP_ID)
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional: primary (default), pattern, minimal, verbose, fewshot, fewshot2
# PROMPT_STYLE=primary
